# systemd user unit, installed by the Jenkinsfile Deploy stage into ~/.config/systemd/user/.
# The app runs docker with host bind mounts (data/), so it runs on the host, not in a container.
[Unit]
Description=uni-sca
After=network-online.target

[Service]
WorkingDirectory=/opt/projects/uni-sca
ExecStart=/usr/bin/env java -jar uni-sca.jar
Restart=on-failure
SuccessExitStatus=143

[Install]
WantedBy=default.target
